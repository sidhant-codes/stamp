PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?appName=Cluster0
COHERE_API_KEY=your-cohere-key
COHERE_MODEL=command-a-03-2025
JWT_SECRET=change-me-to-a-long-random-string
# comma-separated emails that become admin when they register
ADMIN_EMAILS=
# max AI calls (analyze + generate) per user per UTC day
DAILY_AI_LIMIT=20
# password reset emails via https://resend.com (leave empty in dev: the link is printed in the server console)
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
# Number of reverse proxies in front of the API. 0 = none (direct), 1 = e.g. Render/Heroku/nginx.
# Wrong value => clients can spoof their IP (too low is safe-but-shared-bucket, too high is bypassable).
# Check once on your host: log req.ip and the X-Forwarded-For header.
TRUST_PROXY=0
# pino log level: fatal | error | warn | info | debug (default info)
LOG_LEVEL=info
